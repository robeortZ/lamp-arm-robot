[Unit]
Description=Lamp robot manual arm adjustment (soft follow + release lock, gravity-comp like)
After=multi-user.target
Conflicts=greet.service face-follow.service

[Service]
Type=simple
WorkingDirectory=/usr/local/sbin
ExecStart=/root/armenv/bin/python /usr/local/sbin/arm_manual.py run
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
